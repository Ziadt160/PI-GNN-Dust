data/**/*.zip
*.rar

# Checkpoints outside results/ are always strays from an interactive session.
/*.pth
/*.pt
src/**/*.pth

# Throwaway run artifacts: smoke tests and ablation arms overwrite these.
# Real checkpoints are committed deliberately, by name.
results/*smoke*.json
results/ablation/
results/preds/station_*.npz
results/station_model_*_*h.pt
results/checkpoints/
results/logs/
